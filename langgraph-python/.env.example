APP_PORT=8081
AGENTS_SERVER_ADDR=0.0.0.0:8080
LOG_LEVEL=info

POSTGRES_PORT=5433
POSTGRES_DB=agents_at_scale
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_MAX_CONNECTIONS=300
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agents_at_scale
# Each process opens two pools of DB_MAX_OPEN_CONNS (domain queries and
# agent session/checkpoint store). Keep
# (WORKER_REPLICAS + 1) * 2 * DB_MAX_OPEN_CONNS below POSTGRES_MAX_CONNECTIONS.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30

REDIS_PORT=6380
REDIS_URL=redis://redis:6379/0

RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=agents
RABBITMQ_PASSWORD=agents
RABBITMQ_URL=amqp://agents:agents@rabbitmq:5672/
RABBITMQ_QUEUE=agent_jobs

# Worker replicas started by Compose and jobs each replica runs at once.
# The api service always runs with WORKER_CONCURRENCY=0 (publish only).
WORKER_REPLICAS=1
WORKER_CONCURRENCY=1
WORKER_CPUS=1
WORKER_MEMORY=1g
API_CPUS=1
API_MEMORY=512m

# Retries: JOB_MAX_ATTEMPTS total attempts with backoff JOB_RETRY_BASE_MS,
# doubled per retry, then the job goes to <RABBITMQ_QUEUE>.dead. Changing the
# backoff requires deleting the existing <queue>.retry.<n> queues.
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_MS=1000
# Upper bound for the per-conversation lock if a worker dies mid-job.
JOB_LOCK_TTL_MS=300000

# LLM client: same connection cap and timeout in both runtimes.
LLM_MAX_CONNECTIONS=100
LLM_TIMEOUT_SECONDS=60

# Simulated inference time when running with docker-compose.fake-llm.yml.
FAKE_LLM_LATENCY_MS=0
FAKE_LLM_JITTER_MS=0

OPENROUTER_DEPLOYMENT=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
