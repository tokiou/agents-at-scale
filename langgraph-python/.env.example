APP_PORT=8081
AGENTS_SERVER_ADDR=0.0.0.0:8080

POSTGRES_PORT=5433
POSTGRES_DB=agents_at_scale
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/agents_at_scale
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30

REDIS_PORT=6380
REDIS_URL=redis://redis:6379/0

RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=agents
RABBITMQ_PASSWORD=agents
RABBITMQ_URL=amqp://agents:agents@rabbitmq:5672/
RABBITMQ_QUEUE=agent_jobs

OPENROUTER_DEPLOYMENT=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
